# ESQL Skill Test Configuration
# Copy this to .env in the project root and fill in your values.

# =============================================================================
# Elasticsearch Connection (choose one option)
# =============================================================================

# Option 1: Elastic Cloud (API key + Cloud ID)
# Used by test_esql_queries.py to run ESQL queries against a cloud cluster.
# ELASTICSEARCH_API_KEY=your-base64-api-key-here
# ELASTICSEARCH_CLOUD_ID=deployment-name:base64-encoded-cloud-id

# Option 2: Local cluster (username/password)
# ES_URL=http://localhost:9200
# ES_USERNAME=elastic-admin
# ES_PASSWORD=elastic-password
